// Two-layer shaded ASCII cat silhouettes with crisp facial expressions (timeout / offline / sub / port / empty)
import { Theme, IconClock } from "tokens.slint";

export component Face inherits Rectangle {
    in property <string> kind;
    in property <float> stroke: 1.4;
    width: 150px;
    height: 150px;
    property <bool> alt: !IconClock.reduced && Math.mod(Math.floor(IconClock.time / 450), 2) == 1;
    property <length> fs: min(root.width / 28.5, root.height / 21.0);

    property <string> fur:
        root.kind == "timeout" ? (root.alt ? "                                              \n                                              \n            ::                 ::             \n           ::::               ::::            \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       :::::                   :::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::...                 ...::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n       :::::::     :::::::     ::::::::       \n                                              " : "                                              \n                                              \n            ::                 ::             \n           ::::               ::::            \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       :::::                   :::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::...                 ...::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n       :::::::     :::::::     ::::::::       \n                                              ") :
        root.kind == "offline" ? (root.alt ? "                                              \n            ::                 ::             \n           ::::               ::::            \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       ::::...               ...::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::...                 ...::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n       :::::::     :::::::     ::::::::       \n                                              " : "                                              \n            ::                 ::             \n           ::::               ::::            \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       ::::...               ...::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::...                 ...::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n       :::::::     :::::::     ::::::::       \n                                              ") :
        root.kind == "sub" ? (root.alt ? "                                              \n                                              \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       ::::...               ...::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n                                              \n                                              " : "                                              \n                                              \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       ::::...               ...::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n                                              \n                                              ") :
        root.kind == "port" ? (root.alt ? "                                              \n                                              \n            ::                 ::        ::   \n           ::::               ::::       ::   \n          ::::::             ::::::      ::   \n         :::::::::::::::::::::::::::     ::   \n        :::::                   :::::    ::   \n       ::::..                   ..::::   ::   \n       ::::..                   ..::::   ::   \n       ::::...                 ...::::   ::   \n        ::::::.................:::::::::::    \n         :::::::::::::::::::::::::::::::      \n         :::::::::::::::::::::::::::::::      \n        ::::::     ::::::::     :::::::::     \n        ::::::                  :::::::::     \n                                              " : "                                              \n                                              \n            ::                 ::       ::    \n           ::::               ::::      ::    \n          ::::::             ::::::     ::    \n         :::::::::::::::::::::::::::    ::    \n        :::::                   :::::   ::    \n       ::::..                   ..::::  ::    \n       ::::..                   ..::::  ::    \n       ::::...                 ...::::  ::    \n        ::::::.................::::::::::     \n         :::::::::::::::::::::::::::::::      \n         :::::::::::::::::::::::::::::::      \n        ::::::     ::::::::     :::::::::     \n        ::::::                  :::::::::     \n                                              ") :
        (root.alt ? "                                              \n                                              \n            ::                 ::             \n           ::::               ::::            \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       :::::                   :::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::...                 ...::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n       :::::::     :::::::     ::::::::       \n                                              " : "                                              \n                                              \n            ::                 ::             \n           ::::               ::::            \n          ::::::             ::::::           \n         :::::::::::::::::::::::::::          \n        ::::::................:::::::         \n       :::::                   :::::::        \n      ::::..                   ..::::::       \n      ::::..                   ..::::::       \n      ::::...                 ...::::::       \n       ::::::.................::::::::        \n        :::::::::::::::::::::::::::::         \n        :::::::::::::::::::::::::::::         \n       :::::::     :::::::     :::::::        \n       :::::::     :::::::     ::::::::       \n                                              ");

    property <string> art:
        root.kind == "timeout" ? (root.alt ? "                                 o O .        \n            /\\                 /\\             \n           /  \\               /  \\            \n          /    \\             /    \\           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /       \\             /         \\       \n     |         >           <           |      \n   --=              _w_                =--    \n  --==                                 ==--   \n      \\                               /       \n       \\                             /    _   \n       /                             \\   / \\  \n      /       (   )       (   )       \\ / /   \n      \\       (,,,)       (,,,)        / /    \n       \\_______________________________/      " : "                                 . o O        \n            /\\                 /\\             \n           /  \\               /  \\            \n          /    \\             /    \\           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /       \\             /         \\       \n     |         >           <           |      \n   --=              _w_                =--    \n  --==                                 ==--   \n      \\                               /       \n       \\                             /   _    \n       /                             \\  / \\   \n      /       (   )       (   )       \\ | |   \n      \\       (,,,)       (,,,)        / /    \n       \\_______________________________/      ") :
        root.kind == "offline" ? (root.alt ? "            /\\                 /\\   ? ?       \n           /  \\               /  \\   ?        \n          /    \\             /    \\           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /        ___       ___          \\       \n     |        (@  )     (@  )          |      \n   --=         `\"`  _w_  `\"`           =--    \n  --==                                 ==--   \n      \\                               /       \n       \\                             /   _    \n       /                             \\  / \\   \n      /       (   )       (   )       \\ | |   \n      \\       (,,,)       (,,,)        / /    \n       \\_______________________________/      " : "      ? ?   /\\                 /\\             \n       ?   /  \\               /  \\            \n          /    \\             /    \\           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /        ___       ___          \\       \n     |        ( @ )     ( @ )          |      \n   --=         `\"`  _w_  `\"`           =--    \n  --==                                 ==--   \n      \\                               /       \n       \\                             /   _    \n       /                             \\  / \\   \n      /       (   )       (   )       \\ | |   \n      \\       (,,,)       (,,,)        / /    \n       \\_______________________________/      ") :
        root.kind == "sub" ? (root.alt ? "                                              \n          ____/\\             /\\____           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /        ____     ____          \\       \n     |          T         T            |      \n     |          ;   ___   ;            |      \n   --=             /   \\               =--    \n      \\                               /       \n       \\                             /        \n       /                             \\        \n  ____/       (   )       (   )       \\____   \n \\===========(,,,)=======(,,,)===========/    \n  \\_____________________________________/     " : "                                              \n          ____/\\             /\\____           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /        ____     ____          \\       \n     |          T         T            |      \n     |          :   ___   :            |      \n   --=             /   \\               =--    \n      \\                               /       \n       \\                             /        \n       /                             \\        \n  ____/       (   )       (   )       \\____   \n \\===========(,,,)=======(,,,)===========/    \n  \\_____________________________________/     ") :
        root.kind == "port" ? (root.alt ? "                    !! !!                     \n            /\\                 /\\        /\\   \n           /  \\               /  \\      /  \\  \n          /    \\             /    \\     |  |  \n         /      \\___________/      \\    |  |  \n        /                           \\   |  |  \n       /       \\             /       \\  |  |  \n      |       ( @ )       ( @ )       | |  |  \n   ---=           /^^^^^^^\\           = |  |  \n  ---==          /         \\          ==/  /  \n       \\                                  /   \n        \\                               /     \n        /                               \\     \n       /      (   )        (   )         \\    \n       \\      (|||)~~~~~~~~(|||)         /    \n        \\______/               \\________/     " : "                     ! !                      \n            /\\                 /\\       /\\    \n           /  \\               /  \\     /  \\   \n          /    \\             /    \\    |  |   \n         /      \\___________/      \\   |  |   \n        /                           \\  |  |   \n       /       \\             /       \\ |  |   \n      |       ( @ )       ( @ )       ||  |   \n   ---=           /^^^^^^^\\           =|  |   \n  ---==          /         \\          ==  /   \n       \\                                 /    \n        \\                               /     \n        /                               \\     \n       /      (   )        (   )         \\    \n       \\      (|||)~~~~~~~~(|||)         /    \n        \\______/               \\________/     ") :
        (root.alt ? "                                 z Z .        \n            /\\                 /\\             \n           /  \\               /  \\            \n          /    \\             /    \\           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /       _               _       \\       \n     |       \\_/             \\_/       |      \n   --=              _w_                =--    \n  --==                                 ==--   \n      \\                               /       \n       \\                             /    _   \n       /                             \\   / \\  \n      /       (   )       (   )       \\ / /   \n      \\       (,,,)       (,,,)        / /    \n       \\_______________________________/      " : "                                 . z Z        \n            /\\                 /\\             \n           /  \\               /  \\            \n          /    \\             /    \\           \n         /      \\___________/      \\          \n        /                           \\         \n       /                             \\        \n      /       _               _       \\       \n     |       \\_/             \\_/       |      \n   --=              _w_                =--    \n  --==                                 ==--   \n      \\                               /       \n       \\                             /   _    \n       /                             \\  / \\   \n      /       (   )       (   )       \\ | |   \n      \\       (,,,)       (,,,)        / /    \n       \\_______________________________/      ");

    ref := Text {
        visible: false;
        text: "==============================================";
        font-family: Theme.mono;
        font-size: root.fs;
        font-weight: 700;
    }

    Rectangle {
        width: ref.preferred-width + 4px;
        height: parent.height;
        x: (parent.width - self.width) / 2;
        y: 0;
        Text {
            width: parent.width;
            height: parent.height;
            text: root.fur;
            font-family: Theme.mono;
            font-size: root.fs;
            font-weight: 700;
            color: Theme.ink;
            opacity: 0.24;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: root.art;
            font-family: Theme.mono;
            font-size: root.fs;
            font-weight: 700;
            color: Theme.ink;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
}
